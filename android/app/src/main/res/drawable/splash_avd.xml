<?xml version="1.0" encoding="utf-8"?>
<!-- Animated splash icon (Android 12+): the letters fade and settle in,
     then the lime square pops. Total ~0.9 s; set in styles.xml. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_sg">
    <target android:name="s">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="450"
                android:valueFrom="0" android:valueTo="1"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="g">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="450" android:startOffset="120"
                android:valueFrom="0" android:valueTo="1"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="letters">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="650"
                    android:valueFrom="0.88" android:valueTo="1"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="scaleY" android:duration="650"
                    android:valueFrom="0.88" android:valueTo="1"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="square">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="350" android:startOffset="500"
                    android:valueFrom="0" android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:duration="350" android:startOffset="500"
                    android:valueFrom="0" android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
